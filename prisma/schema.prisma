generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  key                String            @unique
  name               String
  config             Json
  isActive           Boolean           @default(true)
  /// @deprecated AUTH-03: not used for token resolution. Prefer portalHostKey in Runtime Config.
  portalCredentialId String?           @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  portalCredential PortalCredential?     @relation(fields: [portalCredentialId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditLogs        ApplicationAuditLog[]

  @@index([portalCredentialId])
}

model PortalCredential {
  id                String   @id @default(uuid()) @db.Uuid
  /// Immutable logical host key referenced by Runtime Config portalHostKey (e.g. gh, rbc).
  key               String   @unique
  name              String
  portalUrl         String
  username          String
  encryptedPassword String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applications Application[]

  @@index([isActive])
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs ApplicationAuditLog[]
}

enum ApplicationAuditAction {
  APPLICATION_CREATED
  APPLICATION_METADATA_UPDATED
  APPLICATION_ACTIVATED
  APPLICATION_DEACTIVATED
  APPLICATION_CONFIG_REPLACED
  PORTAL_CREDENTIAL_CREATED
  PORTAL_CREDENTIAL_UPDATED
  PORTAL_CREDENTIAL_PASSWORD_ROTATED
  PORTAL_CREDENTIAL_ACTIVATED
  PORTAL_CREDENTIAL_DEACTIVATED
  APPLICATION_PORTAL_CREDENTIAL_ASSIGNED
}

model ApplicationAuditLog {
  id             String                 @id @default(uuid()) @db.Uuid
  applicationId  String?                @db.Uuid
  applicationKey String
  actorId        String?                @db.Uuid
  actorEmail     String
  action         ApplicationAuditAction
  before         Json?
  after          Json?
  createdAt      DateTime               @default(now())

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actor       AdminUser?   @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([applicationKey, createdAt(sort: Desc)])
  @@index([actorEmail, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

enum MonitorOutcome {
  PASS
  WARN
  FAIL
  SKIP
}

/// One scheduled or manual pass of the status monitor.
model MonitorRun {
  id          String    @id @default(uuid()) @db.Uuid
  trigger     String
  triggeredBy String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  total       Int       @default(0)
  failed      Int       @default(0)

  results MonitorCheckResult[]

  @@index([startedAt(sort: Desc)])
}

/// Outcome of one monitor check. `detail` is sanitized: never a token or password.
model MonitorCheckResult {
  id                  String         @id @default(uuid()) @db.Uuid
  runId               String         @db.Uuid
  checkType           String
  targetKey           String
  targetLabel         String
  outcome             MonitorOutcome
  latencyMs           Int?
  detail              String?
  meta                Json?
  consecutiveFailures Int            @default(0)
  failingSince        DateTime?
  checkedAt           DateTime       @default(now())

  run MonitorRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([checkType, targetKey, checkedAt(sort: Desc)])
  @@index([checkedAt])
  @@index([runId])
}

/// One row per daily summary email; the unique slot stops two service
/// instances from both sending it.
model MonitorSummary {
  id        String    @id @default(uuid()) @db.Uuid
  slot      DateTime  @unique
  claimedAt DateTime  @default(now())
  sentAt    DateTime?
  ok        Boolean?
  error     String?
}
