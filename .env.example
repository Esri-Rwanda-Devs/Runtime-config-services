DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/runtime_config?schema=public
PORT=3000
ALLOWED_ORIGINS=https://education.example.com,https://localhost:5174,http://localhost:5174,http://localhost:5173,https://localhost:5180,http://localhost:5180

# Required for admin authentication (min 32 characters of high entropy).
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Access token lifetime (default 1h). Examples: 1h, 30m, 3600
JWT_EXPIRES_IN=1h

# AES-256-GCM key for Portal passwords (exactly 32 bytes as base64 or 64-char hex).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORTAL_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-key-base64-or-hex

# Short-lived ArcGIS token lifetime for the consumer broker (minutes, 1–1440). Default: 60
PORTAL_TOKEN_EXPIRATION_MINUTES=60

# Status monitor (admin Status page; api/v1/admin/monitoring)
# Scheduled checks run only when true. A manual run from the admin UI works either way.
MONITOR_ENABLED=false
# Minimum 60000. Default 300000 (5 minutes).
MONITOR_INTERVAL_MS=300000
# JSON object: application key -> public base URL of that app, as users open it.
MONITOR_APP_URLS={"education-mapping":"https://apps.example.com/education-mapping/"}
# Optional. Referer the monitor's portal tokens are bound to (default https://runtime-config-monitor.local).
# MONITOR_REFERER=
# Optional: MONITOR_CONCURRENCY=6, MONITOR_TIMEOUT_MS=10000, MONITOR_RETENTION_DAYS=30

# Status monitor email alerts. Off until host, sender and recipients are all set.
# One email per run, only for changes: a check turning red (2 failures in a row), recovering,
# or a certificate entering its 14-day warning window; plus reminders while a check stays red.
# MONITOR_SMTP_HOST=smtp.example.com
# 587 + STARTTLS by default; set MONITOR_SMTP_SECURE=true for port 465.
# MONITOR_SMTP_PORT=587
# MONITOR_SMTP_SECURE=false
# Keep true: refuse to send if the server does not offer TLS. Only an internal relay should need false.
# MONITOR_SMTP_REQUIRE_TLS=true
# MONITOR_SMTP_USER=
# MONITOR_SMTP_PASSWORD=
# MONITOR_ALERT_FROM=geohub-status@example.com
# Comma-separated.
# MONITOR_ALERT_TO=gis-ops@example.com,admin@example.com
# Hours between reminders while a check stays red (0 = no reminders). Default 24.
# MONITOR_ALERT_REMIND_HOURS=24
# Link to the admin Status page included in each email.
# MONITOR_STATUS_URL=https://apps.example.com/runtime-config/status
# Optional daily summary email at this UTC hour (0-23; e.g. 5 = 07:00 in Kigali). Off when unset.
# Needs email alerts configured and MONITOR_ENABLED=true. Sent once per day across all instances.
# MONITOR_SUMMARY_HOUR=5
